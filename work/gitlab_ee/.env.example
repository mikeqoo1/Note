# ===== GitLab EE on Docker 部署參數 =====
# 複製成 .env 後修改：cp .env.example .env
# 版本請先查 https://hub.docker.com/r/gitlab/gitlab-ee/tags
# 升級不可跳版，先查升級路徑：https://gitlab-com.gitlab.io/support/toolbox/upgrade-path/
GITLAB_VERSION=19.2.1-ee.0

# 對外網址（瀏覽器實際打的 URL，含對外埠號）
# HTTP  範例：http://192.168.199.240:30080
# HTTPS 範例：https://192.168.199.240:30443（需搭配 NGINX_INTERNAL_PORT=443 + 憑證，見 README）
EXTERNAL_URL=http://192.168.199.240:30080

# 容器名稱與主機名
GITLAB_CONTAINER_NAME=gitlab-ee
GITLAB_HOSTNAME=gitlab.concords.com.tw

# 埠對映（host → container）
GITLAB_HTTP_PORT=30080
GITLAB_HTTPS_PORT=30443
GITLAB_SSH_PORT=30022

# 容器內 nginx 監聽埠：HTTP 用 80、HTTPS 用 443
# （固定容器內埠號，避免 external_url 帶非標準埠時 omnibus 把 nginx 監聽埠一起改掉，導致埠對映失效）
NGINX_INTERNAL_PORT=80

# 持久化資料根目錄（config / logs / data 三個子目錄）
GITLAB_HOME=/srv/gitlab-ee

# 時區
TZ=Asia/Taipei

# ===== SMTP（公司 MX 閘道，內網免認證、支援 STARTTLS）=====
SMTP_ADDRESS=mailgw.concords.com.tw
SMTP_PORT=25
GITLAB_EMAIL_FROM=gitlab@concords.com.tw

# ===== 初始 root 密碼 =====
# 預設不設定：首次啟動後 24 小時內到 /etc/gitlab/initial_root_password 查看（deploy.sh 會自動印出）
# 想預設密碼：到 docker-compose.yml 的 environment 加 GITLAB_ROOT_PASSWORD（至少 8 碼），
# 不要在這裡放空值 —— 空字串也會被官方映像當成密碼，reconfigure 會直接 FATAL

# ===== 備份 =====
# gitlab-backup 產出的 tar 保留天數（backup.sh 用）
BACKUP_KEEP_DAYS=7
# secrets / gitlab.rb 額外備份目的地（建議放到別台主機或 NFS）
SECRET_BACKUP_DIR=/srv/gitlab-ee/secret-backup
